rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    match /rooms/{room} {
      function root() { return /databases/$(database)/documents/rooms/$(room); }
      function member() {
        return signed() && exists(/databases/$(database)/documents/rooms/$(room)/members/$(request.auth.uid));
      }
      function selectedSlot() {
        return get(/databases/$(database)/documents/rooms/$(room)/members/$(request.auth.uid)).data.get('slot','');
      }
      function usesHostSlot() {
        return member() && selectedSlot() == '0';
      }
      function voteOwner() {
        let slot = selectedSlot();
        return slot == '' ? request.auth.uid
          : slot == '0' ? get(root()).data.host
          : get(claimPath(slot)).data.uid;
      }
      function validDate(day) {
        return day is string && day.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
      }
      allow get: if signed();
      allow create: if signed() && room.matches('[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['host','night','roster'])
        && (!('roster' in request.resource.data) || (request.resource.data.roster is list
          && request.resource.data.roster.size() >= 1 && request.resource.data.roster.size() <= 24))
        && request.resource.data.host == request.auth.uid && request.resource.data.night == '';
      allow update: if signed() && (resource.data.host == request.auth.uid || usesHostSlot())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['night'])
        && (request.resource.data.night == '' || validDate(request.resource.data.night));
      function claimPath(slot) {
        return /databases/$(database)/documents/rooms/$(room)/claims/$(slot);
      }
      function validSlot(slot) {
        return slot is string && slot.matches('([0-9]|1[0-9]|2[0-3])')
          && int(slot) < getAfter(root()).data.roster.size();
      }
      match /claims/{slot} {
        allow get, list: if signed();
        allow create: if signed() && validSlot(slot)
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/rooms/$(room)/members/$(request.auth.uid)).data.slot == slot
          && (slot != '0' || getAfter(root()).data.host == request.auth.uid);
      }
      match /members/{uid} {
        function rosterSelection() {
          let slot = request.resource.data.slot;
          return request.resource.data.keys().hasOnly(['slot']) && validSlot(slot)
            && (slot == '0' || existsAfter(claimPath(slot)));
        }
        allow get: if signed() && (request.auth.uid == uid || member());
        allow list: if member();
        allow create: if signed() && request.auth.uid == uid
          && getAfter(root()).data.host is string
          && (('roster' in getAfter(root()).data)
            ? rosterSelection()
            : (request.resource.data.keys().hasOnly(['name'])
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 32));
        allow update: if signed() && request.auth.uid == uid && rosterSelection();
      }
      match /months/{month}/votes/{vote} {
        allow read: if member();
        allow create, update: if member()
          && request.resource.data.keys().hasOnly(['date','status','uid'])
          && request.resource.data.uid == voteOwner()
          && validDate(request.resource.data.date) && month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
          && request.resource.data.date.matches(month + '-[0-9]{2}')
          && vote == voteOwner() + '_' + request.resource.data.date
          && request.resource.data.status in ['yes','maybe','no'];
        allow delete: if member() && vote.matches(voteOwner() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }
  }
}
